---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/base/Header';
import { Footer } from '../../../components/base/Footer';
import { Content } from '../../../components/base/Content';
import { Ervip as ErvipContent } from '../../../components/content/products/Accessories/Ervip';

const description = 'ERVIP Vortex Flow Meter, A precise and reliable instrument for measuring liquid and gas flow. ERVIP-NT flow meters: high accuracy, durability, and ease of installation. Detailed parameters of ERVIP.';
---

<Layout description={description}>
  <Header pageType="products" client:load />
  <Content>
    <ErvipContent client:load />
  </Content>
  <Footer client:load />
</Layout>
