---
import Layout from "../../layouts/Layout.astro";
import { Header } from "../../components/base/Header";
import { Footer } from "../../components/base/Footer";
import { Content } from "../../components/base/Content";
import { Services as ServicesContent } from "../../components/content/services/Services";

const description =
  "«New Technologies» Engineering and Production Enterprise LLC  extensive experience in providing services for the repair of oilfield equipment, as well as well dewaxing and flow rate measurement.";
---

<Layout description={description}>
  <Header pageType="services" client:load />
    <Content>
      <ServicesContent client:load />
    </Content>
  <Footer client:load/>
</Layout>